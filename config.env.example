# Copy to config.env and fill in. config.env is git-ignored.
# Every script in scripts/ reads this file; nothing else in the repo is project-specific.

# --- Project -----------------------------------------------------------------
PROJECT_ID=your-project-id
REGION=us-central1

# --- Network (a dedicated VPC; nothing in existing VPCs is modified) --------
VPC_NAME=agw-vpc
SUBNET_NAME=agw-psc-subnet
# /28 is the minimum size for one Agent Gateway. Must not overlap other ranges.
SUBNET_RANGE=10.10.0.0/28
NETWORK_ATTACHMENT=agw-attachment
# Internal IP for the Private Service Connect endpoint for Google APIs.
# Must be outside every subnet range of the VPC.
PSC_ADDRESS_NAME=agw-gapis-ip
PSC_ADDRESS_IP=10.10.1.10
# Lowercase letters and digits only, 1-20 chars (PSC for Google APIs naming rule).
PSC_FORWARDING_RULE=agwgapis
DNS_ZONE_NAME=agw-run-app

# --- Agent Gateway -----------------------------------------------------------
GATEWAY_NAME=agw-egress

# --- Private MCP server (Cloud Run, internal ingress) -----------------------
MCP_SERVICE=hello-mcp
MCP_INVOKER_SA_NAME=mcp-invoker

# --- Agent (Agent Runtime / Agent Engine) -----------------------------------
AGENT_NAME=private_agent
AGENT_DISPLAY_NAME=private-agent
MODEL=gemini-2.5-flash
# Leave empty for the first deploy. scripts/04-deploy-agent.sh stores the id in
# .state/agent_engine_id and reuses it; set it here to target an existing agent.
AGENT_ENGINE_ID=

# --- Optional: BigQuery with end-user OAuth (Gemini Enterprise) -------------
# Leave BQ_DATASET empty to deploy the agent without BigQuery tools.
BQ_DATASET=
# Id of the Gemini Enterprise Authorization resource holding the user's token.
BQ_AUTH_ID=
# true = allow INSERT/UPDATE/DELETE. Default is read-only.
BQ_ALLOW_WRITES=false
